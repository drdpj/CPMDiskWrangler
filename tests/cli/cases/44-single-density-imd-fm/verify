python3 -I - img_rmdd.imd <<'PY'
import sys
b = open(sys.argv[1], 'rb').read(); i = b.index(0x1a) + 1; m = []
while i < len(b):
    mode, c, h, ns, sz = b[i:i + 5]; i += 5 + ns
    for k in range(ns):
        t = b[i]; i += 1
        i += 0 if t == 0 else 1 if t % 2 == 0 else 128 << sz
    m.append((c, mode))
assert [x for c, x in m if c == 0] == [2] and {x for c, x in m if c > 0} == {5}, m
print('ok   img_rmdd.imd: track 0 FM, the rest MFM')
PY
