#!/bin/bash
$TOOL new img.img --format=ibm-3740 --quiet
$TOOL put img.img host/GAME.COM host/DATA.DAT / --format=ibm-3740 --quiet
python3 -I - <<'PY'
d = bytearray(open("img.img", "rb").read())     # an IMD file: find the directory (track 2 on an ibm-3740) and give one entry a block outside the disc
i = d.find(b"GAME    COM")
assert i > 0
d[i + 16] = 0xF0; d[i + 17] = 0xFF
open("img.img", "wb").write(d)
PY
